ANTHROPIC_API_KEY=
CUA_MODEL=claude-opus-5-5
CUA_EFFORT=medium

# Demo-only operator credentials for the local mock target app (target_app/).
# Secrets are referenced by name in goals and artifacts ({"secret": "teller_password"})
# and resolved from CUA_SECRET_<NAME> at execution time. They never reach the model,
# the artifact, or the logs.
CUA_SECRET_TELLER_USERNAME=teller01
CUA_SECRET_TELLER_PASSWORD=Demo-Only-Pass-1
